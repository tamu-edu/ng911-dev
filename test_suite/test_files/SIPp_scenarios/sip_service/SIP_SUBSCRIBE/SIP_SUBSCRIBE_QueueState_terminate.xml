<scenario name="SIP_SUBSCRIBE_QueueState_terminate">
  <Global variables="QUEUE_SIP_URI, PAUSE_MS" />
  <send>
    <![CDATA[

      SUBSCRIBE [$QUEUE_SIP_URI] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      To: <[$QUEUE_SIP_URI]>
      From: SENDER <sip:SENDER@[local_ip]:[local_port]>;tag=QueueStateTag[$From_tag_subscribe]
      Call-ID: [call_id]
      CSeq: 1 SUBSCRIBE
      Max-Forwards: 70
      Event: emergency-QueueState
      Contact: sip:SENDER@[local_ip]:[local_port]
      Expires: 600
      Content-Length: 0

    ]]>
      <operate
            method_name="generate_tag_id"
            ctx_key="From_tag_subscribe"
      />
  </send>
  <recv response="200">
        <operate
            method_name="save_header_field_param_value"
            header_field_name="To:"
            param_name="tag"
            ctx_key="To_tag_subscribe"
        />
  </recv>
  <recv request="NOTIFY">
        <operate
            method_name="save_header_field"
            header_field_name="Via"
            ctx_key="last_Via"
        />
        <operate
            method_name="save_header_field"
            header_field_name="From"
            ctx_key="last_From"
        />
        <operate
            method_name="save_header_field"
            header_field_name="To"
            ctx_key="last_To"
        />
        <operate
            method_name="save_header_field"
            header_field_name="Call-ID"
            ctx_key="last_Call_ID"
        />
        <operate
            method_name="save_header_field"
            header_field_name="CSeq"
            ctx_key="last_CSeq"
        />
  </recv>
  <send>
      <![CDATA[
  
        SIP/2.0 200 OK
        [$last_Via]
        [$last_From]
        [$last_To]
        [$last_Call_ID]
        [$last_CSeq]
        Contact: <sip:SENDER@[local_ip]:[local_port];transport=[transport]>
        Content-Length:0 
    
      ]]>
  </send>

  <pause milliseconds="[$PAUSE_MS]"/>

  <send>
    <![CDATA[

      SUBSCRIBE [$QUEUE_SIP_URI] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      To: <[$QUEUE_SIP_URI]>;tag=[$To_tag_subscribe]
      From: SENDER <sip:SENDER@[local_ip]:[local_port]>;tag=QueueStateTag[$From_tag_subscribe]
      Call-ID: [call_id]
      CSeq: 1 SUBSCRIBE
      Max-Forwards: 70
      Event: emergency-QueueState
      Contact: sip:SENDER@[local_ip]:[local_port]
      Expires: 0
      Content-Length: 0

    ]]>
  </send>
  <recv response="200"> </recv>
  <recv request="NOTIFY">
        <operate
            method_name="save_header_field"
            header_field_name="Via"
            ctx_key="last_Via"
        />
        <operate
            method_name="save_header_field"
            header_field_name="From"
            ctx_key="last_From"
        />
        <operate
            method_name="save_header_field"
            header_field_name="To"
            ctx_key="last_To"
        />
        <operate
            method_name="save_header_field"
            header_field_name="Call-ID"
            ctx_key="last_Call_ID"
        />
        <operate
            method_name="save_header_field"
            header_field_name="CSeq"
            ctx_key="last_CSeq"
        />
  </recv>
  <send>
      <![CDATA[

        SIP/2.0 200 OK
        [$last_Via]
        [$last_From]
        [$last_To]
        [$last_Call_ID]
        [$last_CSeq]
        Contact: <sip:SENDER@[local_ip]:[local_port];transport=[transport]>
        Content-Length:0

      ]]>
  </send>
</scenario>
