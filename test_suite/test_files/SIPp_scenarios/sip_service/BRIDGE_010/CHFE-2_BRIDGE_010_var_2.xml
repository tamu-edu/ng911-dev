<?xml version="1.0" encoding="ISO-8859-1" ?>
<!--

  TEST FILE INFO:

  Version:   010.3d.5.0.0
  Date:      20261022

-->

<scenario name="TS-CHFE-2_BRIDGE_010_var_1_var_2">
    <Global variables="CHFE2_tel, IF_CHFE2_BRIDGE"/>

    <!-- VARIATION 1: Successful Call Establishment (2XX) -->

    <!-- 1. BRIDGE invites CHFE-2 to the Conference -->
    <recv request="INVITE">
        <operate
            method_name="save_header_field"
            header_field_name="Via"
            ctx_key="last_Via"
        />
        <operate
            method_name="save_header_field"
            header_field_name="From"
            ctx_key="last_From"
        />
        <operate
            method_name="save_header_field"
            header_field_name="To"
            ctx_key="last_To"
        />
        <operate
            method_name="save_header_field"
            header_field_name="Call-ID"
            ctx_key="last_Call_ID"
        />
        <operate
            method_name="save_header_field"
            header_field_name="CSeq"
            ctx_key="last_CSeq"
        />

        <operate
            method_name="save_header_field_value"
            header_field_name="Contact"
            without_params="True"
            ctx_key="bridge_contact_uri"
        />

        <!-- Save pure URIs from From and To headers to construct strictly compliant BYE headers -->
        <operate
            method_name="save_header_field_value"
            header_field_name="From"
            without_params="True"
            ctx_key="inv_from_uri"
        />
        <operate
            method_name="save_header_field_value"
            header_field_name="To"
            without_params="True"
            ctx_key="inv_to_uri"
        />

        <!-- Save the Bridge's From tag to use as the To tag in our BYE -->
        <operate
            method_name="save_header_field_param_value"
            header_field_name="From"
            param_name="tag"
            ctx_key="bridge_from_tag"
        />
    </recv>

    <!-- 2. Send 200 OK with SDP Answer -->
    <send>
      <![CDATA[

        SIP/2.0 200 OK
        [$last_Via]
        [$last_From]
        [$last_To];tag=chfe2bridge
        [$last_Call_ID]
        [$last_CSeq]
        Contact: sip:[$CHFE2_tel]@[local_ip]:[local_port]
        Content-Type: application/sdp
        Content-Length: [len]

        v=0
        o=user2 53655765 2353687637 IN IP[local_ip_type] [local_ip]
        s=-
        t=0 0
        c=IN IP[media_ip_type] [media_ip]
        m=audio 5006 RTP/AVP 0
        a=rtpmap:0 PCMU/8000

      ]]>
    </send>

    <!-- 3. CHECK 1: BRIDGE generates ACK for 200 OK -->
    <recv request="ACK"> </recv>

    <!-- Quick 2000ms pause. This ensures CHFE-2 sends BYE well before the main CHFE finishes its 6000ms wait (solving the race condition) -->
    <pause milliseconds="2000"/>

    <!-- 4. Teardown CHFE-2 leg to prepare for Variation 2 -->
    <!-- Using the extracted URIs to strictly comply with RFC 3261 Section 12.2.1.1 -->
    <send>
        <![CDATA[

          BYE [$bridge_contact_uri] SIP/2.0
          Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
          From: <[$inv_to_uri]>;tag=chfe2bridge
          To: <[$inv_from_uri]>;tag=[$bridge_from_tag]
          [$last_Call_ID]
          CSeq: 2 BYE
          Contact: sip:[$CHFE2_tel]@[local_ip]:[local_port]
          Max-Forwards: 70
          Content-Length: 0

        ]]>
    </send>

    <!-- Receive termination confirmation from the Bridge -->
    <recv response="200"> </recv>


    <!-- VARIATION 2: Non-2XX Response (486 Busy Here) -->
    <!-- 5. BRIDGE invites CHFE-2 again for the second variation -->

    <recv request="INVITE">
        <operate
            method_name="save_header_field"
            header_field_name="Via"
            ctx_key="last_Via2"
        />
        <operate
            method_name="save_header_field"
            header_field_name="From"
            ctx_key="last_From2"
        />
        <operate
            method_name="save_header_field"
            header_field_name="To"
            ctx_key="last_To2"
        />
        <operate
            method_name="save_header_field"
            header_field_name="Call-ID"
            ctx_key="last_Call_ID2"
        />
        <operate
            method_name="save_header_field"
            header_field_name="CSeq"
            ctx_key="last_CSeq2"
        />
    </recv>

    <!-- 6. Send 486 Busy Here -->
    <send>
      <![CDATA[

        SIP/2.0 486 Busy Here
        [$last_Via2]
        [$last_From2]
        [$last_To2];tag=chfe2bridge_v2
        [$last_Call_ID2]
        [$last_CSeq2]
        Contact: sip:[$CHFE2_tel]@[local_ip]:[local_port]
        Content-Length: 0

      ]]>
    </send>

    <!-- 7. CHECK 2: BRIDGE generates ACK for Non-2XX -->
    <!-- This is the main check for CHFE-2 for Variation 2 -->
    <recv request="ACK"> </recv>

</scenario>